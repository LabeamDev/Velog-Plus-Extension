{
  "manifest_version": 3,
  "name": "Velog Plus",
  "version": "0.7.2",
  "description": "velog에서 글을 더 편하게 작성하고 읽을 수 있도록 도와주는 확장 프로그램",
  "permissions": ["storage"],
  "host_permissions": [
    "https://velog.velcdn.com/*",
    "https://images.velog.io/*",
    "https://media.vlpt.us/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Velog Plus",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://velog.io/*"],
      "js": ["src/width.js", "src/bridge.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://velog.io/*"],
      "js": ["src/markup.js", "src/grid.js", "src/md-import.js", "src/api.js", "src/editor.js", "src/image.js", "src/importer.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
