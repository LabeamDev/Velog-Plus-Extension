{
  "manifest_version": 3,
  "name": "Velog Plus",
  "version": "0.5.2",
  "description": "velog 본문 폭 조절, 에디터 글자색·배경색, 이미지 크기 조절·자르기·합치기, 마크다운 불러오기",
  "permissions": ["storage"],
  "host_permissions": [
    "https://velog.velcdn.com/*",
    "https://images.velog.io/*",
    "https://media.vlpt.us/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Velog Plus",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://velog.io/*"],
      "js": ["src/width.js", "src/bridge.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://velog.io/*"],
      "js": ["src/markup.js", "src/grid.js", "src/md-import.js", "src/api.js", "src/editor.js", "src/image.js", "src/importer.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
